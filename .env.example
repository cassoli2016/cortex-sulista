# === CÓRTEX — copie para .env e preencha. NUNCA versione o .env real ===

# App
APP_ENV=production
APP_SECRET=__gere_um_segredo_forte__
JWT_TTL_MIN=15

# PostgreSQL (imagem TimescaleDB; extensões: timescaledb, pgvector)
POSTGRES_HOST=postgres
POSTGRES_DB=cortex
POSTGRES_USER=cortex_app
POSTGRES_PASSWORD=__senha__
# role separada só p/ ingestão de telemetria (insert-only)
POSTGRES_INGEST_USER=cortex_ingest
POSTGRES_INGEST_PASSWORD=__senha_ingest__

# Redis
REDIS_URL=redis://redis:6379/0

# IA local
OLLAMA_URL=http://ollama:11434
MODELO_LOCAL=gemma2:9b
# Claude API — opcional, SÓ para tarefas pesadas SEM dado sensível
ANTHROPIC_API_KEY=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=__token__

# Notificações push no celular (Web Push / VAPID). Gere um par com:
#   uv run --with pywebpush python -m py_vapid  (ou peça ao assistente)
# Sem estas chaves o recurso fica desligado (sem erro). VAPID_PRIVATE_KEY é SECRETA.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ti@sulista.com.br
# hora do digest diário (0-23, horário do servidor); padrão 7
PUSH_HORA=7

# Telemetria Gobrax (Premiação de Motoristas) — login do portal (não é API key).
# Sem estas duas a tela nasce "não configurada" (sem erro).
GOBRAX_EMAIL=voce@gobrax.com
GOBRAX_SENHA=YOUR_PASSWORD

# Report de bug/melhoria (botão da logo no canto do painel) -> issue no GitHub.
# Repo SEPARADO e PRIVADO: print de tela do CORTEX carrega faturamento,
# cliente e PII, e o repo do codigo e publico.
# Token: PAT fine-grained com "Contents: write" + "Issues: write" SO neste repo.
# Sem as duas variaveis o botao nem aparece no painel (sem erro).
GITHUB_TOKEN=
REPORT_REPO=cassoli2016/cortex-sulista-reports

# Banco de ESCRITA do CORTEX — PostgreSQL local (o AVA acima e a replica
# somente-leitura do ERP; sao dois bancos diferentes, de proposito).
# Instancia 17, porta 5432 (o AVA usa a mesma PORTA em outro HOST). Sem CORTEX_PG_PASSWORD o recurso fica desligado
# e os modulos ainda nao migrados seguem no SQLite de data/.
# Como criar a role e o banco: docs/MIGRACAO_POSTGRES.md, secao 2.
CORTEX_PG_HOST=127.0.0.1
CORTEX_PG_PORT=5432
CORTEX_PG_DB=cortex
CORTEX_PG_USER=cortex
CORTEX_PG_PASSWORD=

# App do motorista — ACESSO DA ADMINISTRACAO (conferencia).
# Abre o app de QUALQUER motorista, com tarja vermelha na tela dizendo de quem
# e a conta, prazo de 8 horas e registro na trilha de auditoria. E o que
# permite validar, contra o ERP, o que cada tela do app afirma sobre uma
# pessoa.
#
# MINIMO DE 16 CARACTERES: abaixo disso o app RECUSA o proprio codigo e a
# Saude do Servidor diz que recusou — em vez de o acesso ficar fraco calado.
# Use um valor longo e aleatorio; ele nao expira, e o que segura tentativa em
# laco e o teto por endereco (6/hora), nao o prazo.
#
# Sem esta variavel (e sem a chave no cofre da tela de Gestao, que vem antes)
# o acesso simplesmente NAO EXISTE: a rota recusa como recusaria um codigo
# errado, com o mesmo texto. Isso e instalacao incompleta, nao falha.
MOTORISTA_CODIGO_MESTRE=

# Instancia do WhatsApp por onde sai o codigo de entrada do motorista.
# Vazio = a PRINCIPAL, que e a decisao de 06/09/2026 (docs/APP_MOTORISTA.md,
# secao 0-bis): a reserva existe para NAO ser gasta, e o codigo precisa chegar
# num numero que o motorista reconhece.
MOTORISTA_ZAP_INSTANCIA=
