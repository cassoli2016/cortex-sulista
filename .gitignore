# segredos — NUNCA versionar
.env
# dados de runtime (auth.db, ajustes contábeis locais) — não versionar.
# "data/*" (não "data/") de propósito: um ignore de DIRETÓRIO não deixa o git
# olhar regras de negação para arquivos dentro dela - precisa ser padrão de
# arquivo para a excecao abaixo funcionar.
data/*
# EXCECAO: calibracao da previsao de fechamento (Task 8) precisa ir no git —
# get_previsao() le data/previsao_calibracao.json em runtime e o deploy de
# producao e' fast-forward de origin/main (AutoDeploy, ver memoria
# deploy-producao-cortex); sem isto o arquivo nunca chegaria na maquina de
# producao e a calibracao ficaria sempre vazia (calib={}) la.
!data/previsao_calibracao.json
# logs locais do deploy
logs/

# python
.venv/
__pycache__/
*.pyc

# sistema
.DS_Store

# sessões locais do claude
.claude/settings.local.json

# Metadados do editor de SQL (contêm connection string) — não versionar
*.sql.design

# workspace do subagent-driven-development (scratch, nao versionar)
.superpowers/

# PLANILHA NENHUMA ENTRA NO REPOSITORIO. Ele e PUBLICO, e planilha aqui e
# sempre dado real da empresa ou do cliente (faturamento, CNPJ, placa, titulo).
# Em 25/08/2026 o historico foi reescrito para expurgar tres que tinham
# entrado; a regra abaixo e o que impede a quarta.
*.xls
*.xlsx
*.xlsm
*.csv
docs/dre_ia_analise.xlsx

# BARRA NA FRENTE, e ela nao e decoracao: sem a barra o padrao casa em
# QUALQUER nivel, e `antecipacoes/` engolia tambem `api/antecipacoes/` — o
# pacote inteiro do modulo, 6 arquivos de codigo, nunca entrou no repositorio.
# O mesmo tirou `api/orcamento/plano.py`. Reconstruir o servidor a partir do
# git teria produzido um sistema sem antecipacao, e sem aviso nenhum.
# O que precisa ficar de fora e a pasta de PLANILHAS na raiz, nao o codigo
# que as le.
/antecipacoes/
/Planila_Fluxo/
/orcamento/

# scripts temporarios de verificacao que eu crio na raiz durante o trabalho
# (cx_*.py / cx_*.js) — um deles escapou para um commit
cx_*.py
cx_*.js
cx_*.png
cx_*.txt

# CAPTURA DE TELA NENHUMA entra: print do CORTEX carrega nome de motorista,
# chapa, placa, cliente e faturamento, e o repositorio e publico. Um prefixo
# so (cx_*) nao bastou — os arquivos cnh-*.png escaparam por nao casarem com
# ele. Agora barra por EXTENSAO, que e o que o conteudo tem em comum.
*.png
*.jpg
*.jpeg
*.webp
!api/static/**/*.png
!api/static/**/*.jpg

# scratch local de verificacao (estrutura.py etc) - nao versionar
scratchpad/

# (as pastas de planilha dos portais estao ancoradas la em cima, com barra;
# este bloco duplicado era o que de fato ignorava o codigo)

# OFX de teste gerado (dados reais do ERP)
scripts/validacao_extrato/*.ofx
